<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <androidx.appcompat.widget.Toolbar
        android:fontFamily="@font/poppinsbold"
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/terracotta"
        app:title="RuangKarya"
        app:titleTextColor="@color/cream"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="RUANGKARYA"
        android:textColor="@color/terracotta"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppinsbold"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Temukan dan kembangkan kreativitasmu"
        android:textColor="@color/charcoal"
        android:textSize="16sp"
        android:gravity="center"
        android:fontFamily="@font/poppinsregular"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Jelajahi karya lokal dan dukung kreativitas Indonesia."
        android:textColor="@color/charcoal"
        android:textSize="13sp"
        android:gravity="center"
        android:fontFamily="@font/poppinsregular"
        app:layout_constraintTop_toBottomOf="@id/txtUsername"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Kartu project -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/beige"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/terracotta"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/txtPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karya Lokal, Inspirasi Tanpa Batas"
                android:textColor="@color/terracotta"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppinssemibold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RuangKarya adalah ruang untuk menemukan, mengenal, dan mendukung karya lokal. Mari bantu kreativitas lokal tumbuh dan dikenal lebih luas."
                android:textColor="@color/charcoal"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/poppinsregular" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol detail -->
    <Button
        android:id="@+id/btnDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Jelajahi Karya"
        android:textColor="@color/cream"
        android:backgroundTint="@color/terracotta"
        android:fontFamily="@font/poppinssemibold"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardProject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol snackbar -->
    <Button
        android:id="@+id/btnSnackBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Notifikasi"
        android:textColor="@color/cream"
        android:backgroundTint="@color/sage"
        android:fontFamily="@font/poppinssemibold"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Logout"
        android:textColor="@color/cream"
        android:backgroundTint="@color/charcoal"
        android:fontFamily="@font/poppinssemibold"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnSnackBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
