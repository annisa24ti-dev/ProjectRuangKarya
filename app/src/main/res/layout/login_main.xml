<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="35dp"
            android:contentDescription="LogoRuangKarya"
            android:scaleType="fitCenter"
            android:src="@drawable/logoruangkarya" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/poppinssemibold"
            android:text="Selamat Datang!"
            android:textColor="@color/terracotta"
            android:textSize="27sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppinsregular"
            android:gravity="center"
            android:text="Ruang untuk karya lokal tumbuh dan ditemukan."
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/beige"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login Akun"
                    android:textColor="@color/terracotta"
                    android:textSize="21sp"
                    android:fontFamily="@font/poppinssemibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Silakan masuk untuk melanjutkan."
                    android:textColor="@color/charcoal"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppinsregular" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/terracotta"
                    android:fontFamily="@font/poppinsregular"
                    android:hint="Username"
                    android:inputType="text"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/charcoal"
                    android:textColorHint="#665B50"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/terracotta"
                    android:fontFamily="@font/poppinsregular"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/charcoal"
                    android:textColorHint="#665B50"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/terracotta"
                    android:fontFamily="@font/poppinssemibold"
                    android:text="MASUK"
                    android:textColor="@color/cream"
                    android:textSize="15sp"
                    android:textAllCaps="false" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:fontFamily="@font/poppinsregular"
            android:text="Temukan dan dukung karya lokal."
            android:textColor="@color/sage"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
