<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    tools:context=".profile.MoreFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profil Saya"
            android:textColor="@color/charcoal"
            android:textSize="24sp"
            android:fontFamily="@font/poppinsbold"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@color/beige">

            <TextView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="48sp"
                android:background="@color/sage" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nama Pengguna"
                android:textColor="@color/charcoal"
                android:textSize="20sp"
                android:fontFamily="@font/poppinsbold" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Email pengguna"
                android:textColor="@color/charcoal"
                android:textSize="13sp"
                android:fontFamily="@font/poppinsregular" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="Pengaturan Akun"
            android:textColor="@color/charcoal"
            android:textSize="18sp"
            android:fontFamily="@font/poppinsbold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@color/beige"
            android:text="👤    Informasi Profil"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            android:fontFamily="@font/poppinsregular" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            android:background="@color/beige"
            android:text="🛍️    Riwayat Pesanan"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            android:fontFamily="@font/poppinsregular" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            android:background="@color/beige"
            android:text="⚙️    Bantuan dan Pengaturan"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            android:fontFamily="@font/poppinsregular" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Keluar"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/terracotta"
            android:fontFamily="@font/poppinsbold" />

    </LinearLayout>
</ScrollView>
