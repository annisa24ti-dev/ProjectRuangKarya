<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream"
    tools:context=".home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_header_wave">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RuangKarya"
            android:textColor="@android:color/white"
            android:textSize="25sp"
            android:fontFamily="@font/poppinsbold" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Selamat datang!"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:fontFamily="@font/poppinsregular" />

    </LinearLayout>

    <Button
        android:id="@+id/btnExploreComponents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:text="Jelajahi fitur"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:backgroundTint="@color/sage"
        android:fontFamily="@font/poppinssemibold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="Temukan Karya Lokal"
        android:textColor="@color/charcoal"
        android:textSize="18sp"
        android:fontFamily="@font/poppinsbold" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        app:tabIndicatorColor="@color/terracotta"
        app:tabSelectedTextColor="@color/terracotta"
        app:tabTextColor="@color/charcoal"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_product" />

</LinearLayout>
