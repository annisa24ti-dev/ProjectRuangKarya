<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/beige"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/cream"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Gambar atau Emoji Produk -->
        <TextView
            android:id="@+id/tvProductEmoji"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:gravity="center"
            android:text="🏺"
            android:textSize="35sp"
            android:background="@color/sage" />

        <!-- Informasi Produk -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vas Keramik"
                android:textColor="@color/charcoal"
                android:textSize="15sp"
                android:fontFamily="@font/poppinsbold"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvProductCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Kriya"
                android:textColor="@color/charcoal"
                android:textSize="12sp"
                android:fontFamily="@font/poppinsregular" />

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rp89.000"
                android:textColor="@color/terracotta"
                android:textSize="14sp"
                android:fontFamily="@font/poppinsbold" />

        </LinearLayout>

        <!-- Ikon Detail -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_view"
            android:tint="@color/terracotta"
            android:contentDescription="Lihat detail produk" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
